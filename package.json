{
  "name": "@luka-cat-mimi/n8n-nodes-italent",
  "version": "1.0.9",
  "description": "北森 iTalent N8N 集成插件",
  "keywords": [
    "n8n",
    "n8n-node",
    "n8n-community-node-package",
    "italent",
    "北森",
    "HR"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/luka-n8n-nodes/n8n-nodes-italent#readme",
  "author": {
    "name": "luka-cat",
    "email": "luka.cat.mimi@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luka-n8n-nodes/n8n-nodes-italent.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier credentials nodes --write",
    "lint": "eslint \"credentials/**/*.ts\" \"nodes/**/*.ts\" package.json",
    "prepublishOnly": "n8n-node prerelease",
    "build:watch": "tsc --watch",
    "lint:fix": "eslint \"credentials/**/*.ts\" \"nodes/**/*.ts\" package.json --fix",
    "release": "n8n-node release"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ITalentApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ITalent/ITalent.node.js"
    ],
    "strict": false
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@types/node": "^20.19.43",
    "eslint": "9.39.4",
    "gulp": "^5.0.0",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "require-glob": "^4.1.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {
    "glob": "^13.0.6"
  }
}
